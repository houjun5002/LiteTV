<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Web Server Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/web_server"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/web_server_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/web_server_enabled"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/web_server_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Play Source Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/play_source"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/m3u_url"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/m3u_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="textUri"
                    android:background="@drawable/edittext_focus_selector"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/save_m3u_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:focusable="true" />

                <!-- Picking a built-in source is the common case, and typing a URL on a remote is
                     not; this makes switching one button press. -->
                <Button
                    android:id="@+id/pick_builtin_source_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/pick_builtin_source"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/local_m3u_file"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/m3u_file_path_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/pick_m3u_file_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3u_file_pick"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/scan_m3u_file_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3u_scan_import"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/m3u_drop_dir_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/clear_m3u_file_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3u_file_clear"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/m3u_file_priority_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- EPG Source Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/epg_source"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/epg_url"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/epg_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="textUri"
                    android:background="@drawable/edittext_focus_selector"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/save_epg_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:focusable="true" />

                <CheckBox
                    android:id="@+id/epg_display_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_epg_in_channel_list"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/epg_preference_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/epg_preference"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <RadioGroup
                    android:id="@+id/epg_preference_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/epg_preference_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/epg_preference_auto"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/epg_preference_m3u"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/epg_preference_m3u"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/epg_preference_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/epg_preference_user"
                        android:textColor="@color/text_primary" />

                </RadioGroup>

                <TextView
                    android:id="@+id/epg_m3u_embedded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Channel List Appearance Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_opacity"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/sidebar_opacity_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/sidebar_opacity_translucent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sidebar_opacity_translucent"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/sidebar_opacity_semi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sidebar_opacity_semi"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/sidebar_opacity_opaque"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sidebar_opacity_opaque"
                        android:textColor="@color/text_primary" />

                </RadioGroup>

            </LinearLayout>

            <!-- Playback compatibility Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_section"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_render_mode"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/video_render_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/video_render_surface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/video_render_surface"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/video_render_texture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/video_render_texture"
                        android:textColor="@color/text_primary" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_decode_mode"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/video_decode_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/video_decode_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/video_decode_auto"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/video_decode_hardware"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/video_decode_hardware"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/video_decode_software"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/video_decode_software"
                        android:textColor="@color/text_primary" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/playback_settings_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <CheckBox
                    android:id="@+id/video_tunneling_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_tunneling"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- About & Updates Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/settings_section_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_section"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/app_version_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/update_auto_check_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_auto_check"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_auto_check_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/update_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/update_changelog_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/update_last_check_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/check_update_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_check_now"
                    android:background="@drawable/button_focus_selector"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:focusable="true" />

                <!-- Open source: the project is meant to be editable, so the address and the
                     licence it is under are part of what the app has to say about itself. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_section"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/about_project_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/about_source_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/about_license_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>
